@page "/tours"
@using CJTourApp.Services
@using CJTour.Contracts.DTOs
@inject ITourApiService TourApiService
@rendermode InteractiveServer

<PageTitle>Tours</PageTitle>

<h1>Tours</h1>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="LoadAllTours">Load All Tours</button>
    <button class="btn btn-secondary me-2" @onclick="LoadFeaturedTours">Load Featured Tours</button>
    <button class="btn btn-info" @onclick="TestBenchmark">Test Benchmark</button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (tours == null || !tours.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No tours available.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Image</th>
                    <th scope="col">Title</th>
                    <th scope="col">Duration</th>
                    <th scope="col">Participants</th>
                    <th scope="col">Rating</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tour in tours)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(tour.FeaturedImageUrl))
                            {
                                <img src="@tour.FeaturedImageUrl" 
                                     alt="@tour.Name" 
                                     class="img-thumbnail" 
                                     style="width: 60px; height: 60px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center rounded" 
                                     style="width: 60px; height: 60px;">
                                    <i class="bi bi-image text-muted"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <div>
                                <h6 class="mb-1">@tour.Name</h6>
                                @if (!string.IsNullOrEmpty(tour.Subtitle))
                                {
                                    <small class="text-muted">@tour.Subtitle</small>
                                }
                                @if (!string.IsNullOrEmpty(tour.Description))
                                {
                                    <p class="mb-0 small text-truncate" style="max-width: 300px;">@tour.Description</p>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @tour.DurationDays day@(tour.DurationDays != 1 ? "s" : "")
                            </span>
                            @if (tour.DurationHours > 0)
                            {
                                <br />
                                <small class="text-muted">@tour.DurationHours hours</small>
                            }
                        </td>
                        <td>
                            <div class="small">
                                <div><strong>Min:</strong> @tour.MinParticipants</div>
                                <div><strong>Max:</strong> @tour.MaxParticipants</div>
                                @if (tour.CurrentAvailability.HasValue)
                                {
                                    <div class="text-success"><strong>Available:</strong> @tour.CurrentAvailability</div>
                                }
                            </div>
                        </td>
                        <td>
                            @if (tour.AverageRating.HasValue)
                            {
                                <div class="d-flex align-items-center">
                                    <span class="me-1">@tour.AverageRating.Value.ToString("F1")</span>
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            @if (i <= (double)tour.AverageRating.Value)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else if (i - 0.5 <= (double)tour.AverageRating.Value)
                                            {
                                                <i class="bi bi-star-half"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                </div>
                                @if (tour.ReviewCount.HasValue)
                                {
                                    <small class="text-muted">(@tour.ReviewCount reviews)</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">No rating</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-column gap-1">
                                @if (tour.IsFeatured == true)
                                {
                                    <span class="badge bg-primary">Featured</span>
                                }
                                @if (tour.IsActive == true)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                @if (tour.AcceptsMinors == true)
                                {
                                    <span class="badge bg-info text-dark">Family Friendly</span>
                                }
                                @if (tour.Accessible)
                                {
                                    <span class="badge bg-warning text-dark">Accessible</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="btn-group-vertical btn-group-sm" role="group">
                                <button class="btn btn-outline-primary btn-sm" 
                                        @onclick="() => ViewTourDetails(tour.Id)">
                                    <i class="bi bi-eye"></i> View
                                </button>
                                @if (!string.IsNullOrEmpty(tour.Slug))
                                {
                                    <button class="btn btn-outline-info btn-sm" 
                                            @onclick="() => ViewTourBySlug(tour.Slug)">
                                        <i class="bi bi-link"></i> Slug
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <div class="row">
            <div class="col-md-6">
                <p class="text-muted">Showing @tours.Count() tours</p>
            </div>
            <div class="col-md-6 text-end">
                <small class="text-muted">
                    Featured: @tours.Count(t => t.IsFeatured == true) | 
                    Active: @tours.Count(t => t.IsActive == true)
                </small>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(benchmarkMessage))
{
    <div class="alert alert-info mt-3">
        <i class="bi bi-clock"></i> @benchmarkMessage
    </div>
}

@if (!string.IsNullOrEmpty(selectedTourDetails))
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Tour Details</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @((MarkupString)selectedTourDetails)
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<TourDto>? tours;
    private bool isLoading = false;
    private string benchmarkMessage = string.Empty;
    private string selectedTourDetails = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadFeaturedTours();
    }

    private async Task LoadAllTours()
    {
        isLoading = true;
        benchmarkMessage = string.Empty;
        StateHasChanged();

        tours = await TourApiService.GetToursAsync();
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadFeaturedTours()
    {
        isLoading = true;
        benchmarkMessage = string.Empty;
        StateHasChanged();

        tours = await TourApiService.GetFeaturedToursAsync();
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task TestBenchmark()
    {
        benchmarkMessage = "Running benchmark test...";
        StateHasChanged();

        var result = await TourApiService.TestBenchmarkAsync();
        benchmarkMessage = $"Benchmark completed: {result}";
        StateHasChanged();
    }

    private async Task ViewTourDetails(int tourId)
    {
        var tour = await TourApiService.GetTourByIdAsync(tourId);
        if (tour != null)
        {
            selectedTourDetails = "<strong>Title:</strong> " + tour.Name + "<br/>" +
                "<strong>Code:</strong> " + tour.TourCode + "<br/>" +
                "<strong>Description:</strong> " + tour.Description + "<br/>" +
                "<strong>Duration:</strong> " + tour.DurationDays + " days, " + tour.DurationHours + " hours<br/>" +
                "<strong>Participants:</strong> " + tour.MinParticipants + " - " + tour.MaxParticipants + "<br/>";

            if (tour.MinAge.HasValue)
            {
                selectedTourDetails += "<strong>Min Age:</strong> " + tour.MinAge + "<br/>";
            }

            if (!string.IsNullOrEmpty(tour.ActivityLevel))
            {
                selectedTourDetails += "<strong>Activity Level:</strong> " + tour.ActivityLevel + "<br/>";
            }

            if (!string.IsNullOrEmpty(tour.MeetingPoint))
            {
                selectedTourDetails += "<strong>Meeting Point:</strong> " + tour.MeetingPoint + "<br/>";
            }
        }
        StateHasChanged();
    }

    private async Task ViewTourBySlug(string slug)
    {
        var tour = await TourApiService.GetTourBySlugAsync(slug);
        if (tour != null)
        {
            selectedTourDetails = "<strong>Slug:</strong> " + tour.Slug + "<br/>" +
                "<strong>Title:</strong> " + tour.Name + "<br/>" +
                "<strong>SEO Title:</strong> " + (tour.SeoTitle ?? "N/A") + "<br/>" +
                "<strong>SEO Description:</strong> " + (tour.SeoDescription ?? "N/A") + "<br/>" +
                "<strong>Description:</strong> " + tour.Description + "<br/>";
        }
        StateHasChanged();
    }

    private void CloseModal()
    {
        selectedTourDetails = string.Empty;
        StateHasChanged();
    }
}