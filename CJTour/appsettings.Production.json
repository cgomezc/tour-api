{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "CJTour": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "CJTour": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-production-host;Database=cjtour;Username=your_username;Password=your_password"
  },
  "JwtSettings": {
    "Secret": "your-production-super-secret-key-with-at-least-32-characters",
    "Issuer": "CJTour",
    "Audience": "CJTourUsers",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "ApiSettings": {
    "BaseUrl": "https://your-production-domain.com",
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "EnableDetailedErrors": false
  },
  "SecuritySettings": {
    "EnableHttpsRedirection": true,
    "EnableHsts": true,
    "HstsMaxAgeInDays": 365,
    "RequireHttpsMetadata": true
  },
  "AllowedHosts": "*"
} 